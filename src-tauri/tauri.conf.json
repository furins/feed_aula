{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FEED",
  "version": "0.1.0",
  "identifier": "it.feed.aula",
  "build": {
    "beforeDevCommand": "npm run web:build",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FEED",
        "width": 1320,
        "height": 900,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
